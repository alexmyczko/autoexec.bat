# apt install lynx wget make gcc crudini bison flex debhelper-compat libdw-dev libelf-dev libssl-dev rsync
cd /usr/src
# links2 -ssl.certificates 0 -source https://kernel.org/|grep complete|grep tar.xz | head -1|sed "s,.*ref=.,,g;s,xz.*,xz,g"
k=$(lynx -dump https://kernel.org/ |grep tar.xz$|awk '{print $2}'|sort -rV|head -1)
# if you want to go with a longterm kernel
# lynx -dump http://kernel.org/|grep tar.xz$|awk '{print $2}'|sort -rVu|sed 1d
# might also want to go with a debian one: rmadison linux|grep -v bpo|grep -v debug
# to get specific debian kernel version
# debsnap -d . linux $(debsnap -l linux|grep "^6\|^7"|grep -v "bpo\|exp\|rc\|sun"|sort -Vr|fzf)
wget --no-check-certificate $k
tar xf $(basename $k)
cd $(basename $k .tar.xz)
cp /boot/config-$(uname -r) .config
# now might want to play with
# kernel-hardening-checker -g $(arch|tr '[:lower:]' '[:upper:]')
yes "" | make oldconfig
